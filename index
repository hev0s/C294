<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Gestion Étudiants Vue.js</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
</head>
<body class="bg-light">

<div id="app">
    <div class="container py-5">
        <h1 class="text-center mb-5">Gestion des Étudiants</h1>
        <div class="row">
            <div class="col-md-5 mb-4">
                <student-form @add-student="addStudent"></student-form>
            </div>
            <div class="col-md-7">
                <student-list :students="students"></student-list>
            </div>
        </div>
    </div>
</div>

<script>
    const { createApp, ref, reactive, computed } = Vue;

    // --- COMPOSANT 1 : LE FORMULAIRE ---
    const StudentForm = {
        template: `
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">Ajouter un étudiant</div>
                <div class="card-body">
                    <form @submit.prevent="submitForm">
                        <div class="mb-3">
                            <label class="form-label">Prénom</label>
                            <input type="text" v-model="form.firstName" class="form-control" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Nom</label>
                            <input type="text" v-model="form.lastName" class="form-control" required>
                        </div>
                        <div class="row">
                            <div class="col-6 mb-3">
                                <label class="form-label">Date de naissance</label>
                                <input type="date" v-model="form.dob" class="form-control">
                            </div>
                            <div class="col-6 mb-3">
                                <label class="form-label">Genre</label>
                                <select v-model="form.gender" class="form-select">
                                    <option>Homme</option>
                                    <option>Femme</option>
                                    <option>Autre</option>
                                </select>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Centres d'intérêt (Max 3)</label>
                            <div v-for="option in interestOptions" :key="option" class="form-check">
                                <input class="form-check-input" type="checkbox" :value="option" v-model="form.interests" :disabled="form.interests.length >= 3 && !form.interests.includes(option)">
                                <label class="form-check-label">{{ option }}</label>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label d-flex justify-content-between">
                                <span>Caractère ({{ form.mood }})</span>
                                <span class="fs-4">{{ currentEmoji }}</span>
                            </label>
                            <input type="range" v-model.number="form.mood" class="form-range" min="10" max="100" step="10">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Motivation</label>
                            <textarea v-model="form.motivation" class="form-control" rows="2"></textarea>
                        </div>
                        <button type="submit" class="btn btn-success w-100">Ajouter</button>
                    </form>
                </div>
            </div>
            `,
        emits: ['add-student'],
        setup(props, { emit }) {
            const interestOptions = ['Sport', 'Environnement', 'Science', 'Technologie', 'Actualité'];
            const form = reactive({ firstName: '', lastName: '', dob: '', gender: 'Homme', mood: 50, motivation: '', interests: [] });

            function getEmojiByMood(mood) {
                let emojis = ["😢", "😁", "😊", "😒", "😃", "😐", "😖", "😤", "😟", "😆"];
                let index = Math.floor(mood / 10) - 1;
                if (index === -1) index = 0;
                if (index >= emojis.length) index = emojis.length - 1;
                return emojis[index];
            }

            const currentEmoji = computed(() => getEmojiByMood(form.mood));

            const submitForm = () => {
                if (!form.firstName || !form.lastName) return;
                const newStudent = { ...form, emoji: getEmojiByMood(form.mood) };
                emit('add-student', newStudent);
                // Reset
                form.firstName = ''; form.lastName = ''; form.dob = ''; form.motivation = ''; form.interests = []; form.mood = 50;
            };

            return { form, interestOptions, currentEmoji, submitForm };
        }
    };

    // --- COMPOSANT 2 : LA LISTE ---
    const StudentList = {
        props: ['students'],
        template: `
            <div v-if="students.length > 0">
                <h3 class="mb-3">Liste des étudiants ({{ students.length }})</h3>
                <div class="row">
                    <div class="col-12 mb-3" v-for="(student, index) in students" :key="index">
                        <div class="card h-100 border-primary">
                            <div class="card-header d-flex justify-content-between align-items-center bg-light">
                                <h5 class="m-0 text-primary">{{ student.firstName }} {{ student.lastName }}</h5>
                                <span class="fs-2">{{ student.emoji }}</span>
                            </div>
                            <div class="card-body">
                                <p><strong>Genre :</strong> {{ student.gender }} | <strong>Né(e) :</strong> {{ formatDate(student.dob) }}</p>
                                <p><strong>Intérêts :</strong> {{ student.interests.join(', ') || 'Aucun' }}</p>
                                <hr>
                                <p><em>{{ student.motivation || "Pas de motivation" }}</em></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            `,
        setup() {
            const formatDate = (d) => d ? new Date(d).toLocaleDateString('fr-FR') : 'Non renseignée';
            return { formatDate };
        }
    };

    // --- APPLICATION PRINCIPALE (PARENT) ---
    const app = createApp({
        setup() {
            const students = ref([]);
            const addStudent = (newStudent) => {
                students.value.push(newStudent);
            };
            return { students, addStudent };
        }
    });

    // Enregistrement des composants
    app.component('student-form', StudentForm);
    app.component('student-list', StudentList);

    // Montage de l'app
    app.mount('#app');
</script>
</body>
</html>